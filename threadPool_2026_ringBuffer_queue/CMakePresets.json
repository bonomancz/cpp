{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-msvc",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_LINKER": "lld-link.exe",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "/DEBUG:GHASH"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64-debug",
      "inherits": "base-msvc",
        "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64-release",
      "inherits": "base-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug", 
      "jobs": 12
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "jobs": 12      
    }
  ]
}
